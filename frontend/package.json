{
  "name": "agent-observability-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test prototype.e2e.ts",
    "test:e2e:mock": "playwright test --config playwright.mock.config.mjs",
    "test:e2e:real": "playwright test --config playwright.real.config.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "1.52.0",
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.1.3",
    "vue-tsc": "2.2.10"
  }
}
