{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "2.0"
    },
    "run_id": {
      "type": "string",
      "format": "uuid"
    },
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "expected_last_seq": {
      "type": "integer",
      "minimum": 0
    },
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "producer_event_id": {
                "type": "string",
                "format": "uuid"
              },
              "kind": {
                "const": "span.started"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "span_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$"
                  },
                  "parent_span_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-f]{16}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "agent_id": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uuid"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "operation_type": {
                    "enum": [
                      "AGENT",
                      "LLM",
                      "TOOL",
                      "RETRIEVAL",
                      "WORKFLOW",
                      "OTHER"
                    ]
                  },
                  "span_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "node_key": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?!sys_)[a-z][a-z0-9_]{0,49}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "role_key": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?!sys_)[a-z][a-z0-9_]{0,49}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "attempt_no": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "start_time": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "attributes": {
                    "type": "object"
                  }
                },
                "required": [
                  "span_id",
                  "parent_span_id",
                  "agent_id",
                  "operation_type",
                  "span_name",
                  "node_key",
                  "role_key",
                  "attempt_no",
                  "start_time",
                  "attributes"
                ]
              },
              "occurred_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "producer_event_id",
              "kind",
              "payload",
              "occurred_at"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "producer_event_id": {
                "type": "string",
                "format": "uuid"
              },
              "kind": {
                "const": "span.finished"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "span_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$"
                  },
                  "status": {
                    "enum": [
                      "SUCCESS",
                      "ERROR"
                    ]
                  },
                  "end_time": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "input_tokens": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2147483647
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "output_tokens": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 2147483647
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "provider": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 80
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "model_name": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 120
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "tool_name": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 120
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "error_type": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "error_message": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "span_id",
                  "status",
                  "end_time",
                  "input_tokens",
                  "output_tokens",
                  "provider",
                  "model_name",
                  "tool_name",
                  "error_type",
                  "error_message"
                ]
              },
              "occurred_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "producer_event_id",
              "kind",
              "payload",
              "occurred_at"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "producer_event_id": {
                "type": "string",
                "format": "uuid"
              },
              "kind": {
                "const": "span.event"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "event_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "span_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$"
                  },
                  "event_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "severity": {
                    "enum": [
                      "TRACE",
                      "DEBUG",
                      "INFO",
                      "WARN",
                      "ERROR"
                    ]
                  },
                  "message": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "occurred_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "attributes": {
                    "type": "object"
                  }
                },
                "required": [
                  "event_id",
                  "span_id",
                  "event_name",
                  "severity",
                  "message",
                  "occurred_at",
                  "attributes"
                ]
              },
              "occurred_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "producer_event_id",
              "kind",
              "payload",
              "occurred_at"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "producer_event_id": {
                "type": "string",
                "format": "uuid"
              },
              "kind": {
                "const": "link.created"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "source_span_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$"
                  },
                  "target_span_id": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$"
                  },
                  "link_type": {
                    "enum": [
                      "DEPENDS_ON",
                      "RETRY_OF",
                      "HANDOFF"
                    ]
                  }
                },
                "required": [
                  "source_span_id",
                  "target_span_id",
                  "link_type"
                ]
              },
              "occurred_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "producer_event_id",
              "kind",
              "payload",
              "occurred_at"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "producer_event_id": {
                "type": "string",
                "format": "uuid"
              },
              "kind": {
                "const": "node.skipped"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "node_key": {
                    "type": "string",
                    "pattern": "^(?!sys_)[a-z][a-z0-9_]{0,49}$"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "node_key",
                  "reason"
                ]
              },
              "occurred_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "producer_event_id",
              "kind",
              "payload",
              "occurred_at"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "producer_event_id": {
                "type": "string",
                "format": "uuid"
              },
              "kind": {
                "const": "checkpoint.saved"
              },
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "checkpoint_version": {
                    "const": 1
                  }
                },
                "required": [
                  "checkpoint_version"
                ]
              },
              "occurred_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "producer_event_id",
              "kind",
              "payload",
              "occurred_at"
            ]
          }
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "checkpoint": {
      "$ref": "#/$defs/checkpoint"
    },
    "terminal": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "SUCCESS",
                "FAILED",
                "CANCELLED"
              ]
            },
            "error_summary": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "status",
            "error_summary"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "protocol_version",
    "run_id",
    "batch_id",
    "lease_epoch",
    "expected_last_seq",
    "events",
    "checkpoint",
    "terminal"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-observability:v2:journal-batch",
  "title": "JournalBatch v2",
  "$defs": {
    "span_open": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "span_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "parent_span_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "agent_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_type": {
          "enum": [
            "AGENT",
            "LLM",
            "TOOL",
            "RETRIEVAL",
            "WORKFLOW",
            "OTHER"
          ]
        },
        "span_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "node_key": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!sys_)[a-z][a-z0-9_]{0,49}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "role_key": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?!sys_)[a-z][a-z0-9_]{0,49}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_no": {
          "type": "integer",
          "minimum": 1
        },
        "start_time": {
          "type": "string",
          "format": "date-time"
        },
        "attributes": {
          "type": "object"
        }
      },
      "required": [
        "span_id",
        "parent_span_id",
        "agent_id",
        "operation_type",
        "span_name",
        "node_key",
        "role_key",
        "attempt_no",
        "start_time",
        "attributes"
      ]
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "checkpoint_version": {
          "const": 1
        },
        "definition_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "clock_mode": {
          "enum": [
            "REALTIME",
            "VIRTUAL"
          ]
        },
        "logical_time_ms": {
          "type": "number",
          "minimum": 0
        },
        "node_states": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!sys_)[a-z][a-z0-9_]{0,49}$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "state": {
                "enum": [
                  "PENDING",
                  "RUNNING",
                  "SUCCESS",
                  "ERROR",
                  "SKIPPED",
                  "CANCELLED"
                ]
              },
              "attempt_no": {
                "type": "integer",
                "minimum": 0
              },
              "result": {
                "anyOf": [
                  {
                    "enum": [
                      "PASS",
                      "FAIL"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "span_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                },
                "minItems": 0,
                "maxItems": 500
              }
            },
            "required": [
              "state",
              "attempt_no",
              "result",
              "span_ids"
            ]
          }
        },
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "node_key": {
                "type": "string",
                "pattern": "^(?!sys_)[a-z][a-z0-9_]{0,49}$"
              },
              "attempt_no": {
                "type": "integer",
                "minimum": 1
              },
              "span_id": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              },
              "state": {
                "enum": [
                  "RUNNING",
                  "SUCCESS",
                  "ERROR"
                ]
              }
            },
            "required": [
              "node_key",
              "attempt_no",
              "span_id",
              "state"
            ]
          },
          "minItems": 0,
          "maxItems": 500
        },
        "open_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span_open"
          },
          "minItems": 0,
          "maxItems": 500
        },
        "completed_span_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "minItems": 0,
          "maxItems": 500
        },
        "resolved_routes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(?!sys_)[a-z][a-z0-9_]{0,49}$"
          },
          "additionalProperties": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          }
        },
        "journal_seq": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "checkpoint_version",
        "definition_hash",
        "clock_mode",
        "logical_time_ms",
        "node_states",
        "attempts",
        "open_spans",
        "completed_span_ids",
        "resolved_routes",
        "journal_seq"
      ]
    }
  }
}
