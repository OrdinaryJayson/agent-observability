# Copy to .env at repository root. Choose your own local password.
POSTGRES_DB=agent_observability
POSTGRES_USER=agent_user
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Optional override; when empty the backend derives it from POSTGRES_*.
DATABASE_URL=
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# Local isolated index experiments; disabled unless explicitly enabled.
BENCHMARK_ENABLED=false
# V2 experiments use a different physical database ending in _lab or _test.
EXPERIMENT_ENABLED=false
EXPERIMENT_DATABASE_URL=
TESTDATA_ENABLED=false
# Deployment identifier only; never put credentials in this field.
CODE_REVISION=unknown
